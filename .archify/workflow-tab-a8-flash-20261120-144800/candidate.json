    { "id": "longpress", "lane": "tablet", "col": 2, "type": "security", "label": "Long-press Volume Up", "sublabel": "unlocks the bootloader", "tag": "wipes everything" },
    { "id": "boottwrp", "lane": "tablet", "col": 3, "type": "frontend", "label": "Boot into TWRP", "sublabel": "Power + Volume Up" },
    { "id": "format", "lane": "tablet", "col": 4, "type": "security", "label": "Format Data", "sublabel": "then Reboot > Fastboot", "tag": "followed, not checked" },
