    { "id": "twrp", "lane": "pc", "col": 3, "type": "backend", "label": "Flash TWRP", "sublabel": "-p 38 --no-reboot" },
    { "id": "system", "lane": "pc", "col": 4, "type": "backend", "label": "fastboot flash system", "sublabel": "the GSI, about 99 s" },
    { "id": "recovery", "lane": "pc", "col": 5, "type": "backend", "label": "fastboot flash recovery", "sublabel": "stock again, then reboot", "tag": "no vbmeta flashed" },

    { "id": "menu", "lane": "back", "col": 1, "type": "database", "label": "Stock recovery menu", "sublabel": "shows, tablet boots" },
    { "id": "restore", "lane": "back", "col": 5, "type": "external", "label": "Full stock restore", "sublabel": "never run" }
