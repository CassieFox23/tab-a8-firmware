  "mainPath": ["oem", "firmware", "download", "writetest", "longpress", "readback", "twrp", "boottwrp", "format", "system", "recovery", "boots"],
  "nodes": [
    { "id": "oem", "lane": "tablet", "col": 0, "type": "frontend", "label": "OEM unlocking on", "sublabel": "Developer options" },
